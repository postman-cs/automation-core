{
  "name": "@postman/automation-core",
  "version": "1.7.0",
  "description": "Shared runtime core for postman-actions: HTTP transport foundations, structured logging, context detection, and telemetry.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cassette": {
      "types": "./dist/cassette.d.ts",
      "import": "./dist/cassette.js"
    },
    "./route-manifest": {
      "types": "./dist/route-manifest.d.ts",
      "import": "./dist/route-manifest.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package-exports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postman",
    "telemetry",
    "logging",
    "http",
    "testing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postman-cs/automation-core.git"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "fast-uri": ">=3.1.5",
    "nanoid@3": "3.3.18",
    "js-yaml@4": "4.3.1",
    "postcss": ">=8.5.26",
    "vite@8": "8.2.1",
    "ws": ">=8.21.3",
    "sharp": ">=0.35.0",
    "undici": "^6.28.0"
  }
}
